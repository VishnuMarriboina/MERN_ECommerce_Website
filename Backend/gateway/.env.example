PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Max time (ms) the gateway waits for a downstream service to respond before
# returning 504 Gateway Timeout instead of hanging the client request.
PROXY_TIMEOUT_MS=30000

# When a downstream service responds 429/502/503/504 (e.g. Render free-tier
# services waking from hibernation), the gateway retries with this backoff
# schedule (ms, comma-separated) before giving up. Real cold starts commonly
# take 10-30s, so this spaces retries out (~21s worst case) instead of one
# single fixed wait, to give the instance a real chance to be up in time.
PROXY_RETRY_DELAYS_MS=3000,6000,12000

# ─── Service URLs ────────────────────────────────────────────────────────────
# Each variable accepts a single URL (development) or comma-separated URLs
# (production). The gateway's built-in Round-Robin load balancer distributes
# requests across all URLs in the list — no extra software required.

# Single instance (development default)
AUTH_SERVICE_URLS=http://localhost:3001
PRODUCT_SERVICE_URLS=http://localhost:3002
CART_SERVICE_URLS=http://localhost:3003
ORDER_SERVICE_URLS=http://localhost:3004

# Multiple instances — uncomment and add more URLs to enable load balancing
# AUTH_SERVICE_URLS=http://localhost:3001,http://localhost:3011
# PRODUCT_SERVICE_URLS=http://localhost:3002,http://localhost:3012,http://localhost:3022
# CART_SERVICE_URLS=http://localhost:3003,http://localhost:3013
# ORDER_SERVICE_URLS=http://localhost:3004,http://localhost:3014
