{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "gateway",
    "services/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "start:gateway": "cd gateway && npm start",
    "start:auth": "cd services/auth-service && npm start",
    "start:product": "cd services/product-service && npm start",
    "start:cart": "cd services/cart-service && npm start",
    "start:order": "cd services/order-service && npm start",
    "dev:all": "concurrently \"cd gateway && npm run dev\" \"cd services/auth-service && npm run dev\" \"cd services/product-service && npm run dev\" \"cd services/cart-service && npm run dev\" \"cd services/order-service && npm run dev\"",
    "seed": "node seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "mongoose": "^8.16.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
