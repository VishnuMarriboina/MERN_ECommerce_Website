NODE_ENV=development

# seed.js writes into each service's own database — see scripts/migrate-split-databases.js
# DB_USERNAME / DB_PASSWORD / MDB_HOST live in .env.secrets (gitignored), not here
AUTH_MDB_DBNAME=auth_db
PRODUCT_MDB_DBNAME=product_db
ORDER_MDB_DBNAME=order_db

JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
