# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment files ───────────────────────────────────────────────────────
# Never commit real secrets. Commit only *.example and .env.shared
.env
**/.env
.env.local
**/.env.local
.env.development
**/.env.development
.env.production
**/.env.production
.env.secrets
**/.env.secrets
# Single consolidated Render deployment reference (Backend/.envRender) —
# copy-paste source for each service's Render dashboard, not read by any code.
.envRender
**/.envRender
!**/.env.example
!**/.env.shared

# ─── Build output ────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
**/dist/
**/build/

# ─── Test & coverage ─────────────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Editor directories ──────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.sw?

# ─── Docker ──────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ─── Sensitive files ─────────────────────────────────────────────────────────
*.pem
*.key
